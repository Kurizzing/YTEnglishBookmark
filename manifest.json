{
  "manifest_version": 3,
  "key": "",
  "name": "EngBookmark · 영어 듣기 북마크",
  "version": "1.2.0",
  "minimum_chrome_version": "114",
  "description": "Q로 시점 저장, W 두 번으로 구간 저장. 날짜별 북마크로 유튜브 영어 듣기를 연습하세요.",
  "permissions": ["storage", "sidePanel"],
  "host_permissions": ["https://www.youtube.com/*"],
  "background": { "service_worker": "background.js" },
  "side_panel": { "default_path": "popup.html" },
  "action": {
    "default_title": "영어 듣기 북마크",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [{
    "matches": ["https://www.youtube.com/*"],
    "js": ["core.js", "captions.js", "content.js"],
    "run_at": "document_idle"
  }, {
    "matches": ["https://www.youtube.com/*"],
    "js": ["caption-source.js"],
    "world": "MAIN",
    "run_at": "document_idle"
  }]
}
